# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Local development via docker-compose:
DATABASE_URL="postgresql://workaholic:workaholic_dev_password@localhost:5432/workaholic?schema=public"

# JWT Authentication Secret (Required in production)
JWT_SECRET="workaholic_super_secret_jwt_key_replace_in_production"

# Client URL (for CORS and cookie sameSite)
CLIENT_URL="http://localhost:5173"

# Cookie SameSite setting ('lax' for same-domain, 'none' for cross-domain)
COOKIE_SAME_SITE="lax"

# Google Gemini API Key (for AI Board Summary)
GEMINI_API_KEY=""
